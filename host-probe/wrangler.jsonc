{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "browser-tetris-lab-probe",
  // Asset-only config: no Worker script, so the Workers Free 100k/day request cap
  // stays inert (static asset requests are exempt) and `_headers` applies to the
  // responses. A Worker script here would switch both of those off.
  "compatibility_date": "2026-11-02",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Custom subdomain. apply-route.sh rewrites the next line (and --clear undoes
  // it); it stays commented until the domain's zone lives on Cloudflare, because
  // a route without a zone fails the deploy. The trailing comma above keeps both
  // the commented and the uncommented form valid JSON.
  "routes": [{ "pattern": "lab.samibentaleb.com", "custom_domain": true }]
}
